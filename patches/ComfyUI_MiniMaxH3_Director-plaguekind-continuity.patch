+def unload_clip_after_conditioning(clip) -> int:
+    """Release only the CLIP/Qwen patcher after conditioning is materialized."""
+    patcher = getattr(clip, "patcher", None)
+    if patcher is None:
+        return 0
+    released = 0
+    try:
+        import comfy.model_management as mm
+
+        try:
+            import comfy.model_prefetch
+
+            comfy.model_prefetch.cleanup_prefetch_queues()
+        except Exception as prefetch_exc:
+            log.debug("Qwen prefetch cleanup skipped: %s", prefetch_exc)
+        mm.unload_model_and_clones(
+            patcher,
+            unload_additional_models=False,
+            all_devices=True,
+        )
+        if hasattr(patcher, "partially_unload_ram"):
+            released = int(patcher.partially_unload_ram(1 << 60) or 0)
+        gc.collect()
+        mm.soft_empty_cache()
+    except Exception as exc:
+        log.warning("Qwen unload after conditioning failed: %s", exc)
+        return 0
+    log.info(
+        "MiniMax H3 Director: Qwen/CLIP released after conditioning "
+        "(dynamic pins %.1f MB)",
+        released / (1024 * 1024),
+    )
+    return released
