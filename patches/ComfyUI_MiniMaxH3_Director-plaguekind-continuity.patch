+def cleanup_segment_vram(
+    *,
+    enabled: bool = True,
+    unload_models: bool = True,
+    release_dynamic_pins: bool = False,
+) -> None:
+    """Release segment memory without invoking the expensive Distorch object scan.
+
+    ``release_dynamic_pins`` is intended for transitions between long H3
+    segments on small-VRAM systems. It drops ComfyUI's asynchronous weight
+    prefetch/pinned-RAM state after unloading GPU residency, preventing the
+    next segment from paging tens of gigabytes between RAM and VRAM.
+    """
+    if not enabled:
+        return
+    started = time.monotonic()
+    gc.collect()
+    try:
+        import comfy.model_management as mm
+
+        mm.cleanup_models_gc()
+        if unload_models:
+            try:
+                import comfy.model_prefetch
+
+                comfy.model_prefetch.cleanup_prefetch_queues()
+            except Exception as prefetch_exc:
+                log.debug("Model prefetch cleanup skipped: %s", prefetch_exc)
+            mm.unload_all_models()
+            mm.cleanup_models()
+        released_pins = 0
+        if release_dynamic_pins:
+            try:
+                released_pins = int(
+                    mm.free_pins(1 << 60, evict_active=True, loaded=False) or 0
+                )
+                # Async offload registrations can retain a large Windows RAM
+                # working set even after GPU residency has been unloaded.
+                mm.free_registrations(1 << 60, evict_active=True)
+            except Exception as pins_exc:
+                log.debug("Dynamic weight pin cleanup skipped: %s", pins_exc)
+        # Collect again after model and pin eviction so dead wrappers and
+        # temporary tensors cannot survive into the next segment.
+        gc.collect()
+        mm.soft_empty_cache()
+        try:
+            import torch
+
+            if torch.cuda.is_available():
+                torch.cuda.empty_cache()
+                # Releases CUDA IPC allocations when supported; harmless when
+                # no IPC pool exists and useful on long chained generations.
+                if hasattr(torch.cuda, "ipc_collect"):
+                    torch.cuda.ipc_collect()
+        except Exception as cuda_exc:
+            log.debug("Explicit CUDA cache cleanup skipped: %s", cuda_exc)
     except Exception as exc:
         log.warning("Segment VRAM cleanup failed: %s", exc)
